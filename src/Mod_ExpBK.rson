                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 100,
                    "Pos.y": 970,
                    "Parent": -1,
                    "#": 549,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "// А теперь мы начинаем проверять - может ли игрок проинвестировать чего-нибудь, или не время?",
                        "",
                        "// В первую очередь посмотрим ванильные инвестиции",
                        "Inv_str = '';",
                        "tdwd = ControlledSystems(0); // Хранит количество подконтрольных систем Коалиции",
                        "",
                        "// ГЛОБАЛЬНЫЕ/ОБЩИЕ СЧЁТЧИКИ (Сбрасываем перед единым подсчётом)",
                        "int total_transports = 0;",
                        "int total_warriors = 0;",
                        "int total_pirates = 0;",
                        "",
                        "// ОДИН ЦИКЛ ДЛЯ СБОРА ВСЕЙ СТАТИСТИКИ ГАЛАКТИКИ",
                        "for(i = 0; GalaxyStars() > i; i = i + 1) {",
                        "    tdwd3 = GalaxyStar(i);",
                        "    if(!tdwd3) continue;",
                        "    for(j = 0; StarShips(tdwd3) > j; j = j + 1) {",
                        "        dword cur_ship = StarShips(tdwd3, j);",
                        "        int ship_type = ShipTypeN(cur_ship);",
                        "",
                        "        if(ship_type == t_Transport)     total_transports = total_transports + 1;",
                        "        else if(ship_type == t_Warrior)  total_warriors = total_warriors + 1;",
                        "        else if(ship_type == t_Pirate)   total_pirates = total_pirates + 1;",
                        "    }",
                        "}",
                        "",
                        "// 1. ИНВЕСТИЦИИ В ТРАНСПОРТЫ (ЛАЙНЕРЫ)",
                        "if(LinerCD < 1) {",
                        "    if(round(total_transports / GalaxyStars()) < 5) {",
                        "        for(i = 0; GalaxyStars() > i; i = i + 1) {",
                        "            StarForLiners = StarNearbyStars(ShipStar(Player()), i);",
                        "",
                        "            if(StarOwner(StarForLiners)) continue;",
                        "            if(DistToNearestEnemySystem(StarForLiners) < 10) continue;",
                        "            if(StarCustomFaction(StarForLiners) != '') continue;",
                        "",
                        "            InjectAnswer('Transports', CT('Invests.TransportsBuy'), 3);",
                        "            Inv_str = Inv_str + Format(CT('Invests.Transports'), 'money', GalaxyMoney(3, 4) * 5, 'star', Name(StarForLiners)) + CT('FormInfo.br');",
                        "            break;",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "// 2. КОЛОНИЗАЦИЯ",
                        "if(ColonCD < 1) {",
                        "    InjectAnswer('Colonisation', CT('Invests.ColonisationBuy'), 4);",
                        "    Inv_str = Inv_str + CT('Invests.Colonisation') + CT('FormInfo.br');",
                        "}",
                        "",
                        "// 3. ИНВЕСТИЦИИ В ВОЕННЫХ",
                        "if(WarCD < 1) {",
                        "    if(round(total_warriors / GalaxyStars()) < 7) {",
                        "        for(j = 0; GalaxyStars() > j; j = j + 1) {",
                        "            StarForWarr = StarNearbyStars(ShipStar(Player()), j);",
                        "",
                        "            if(StarOwner(StarForWarr)) continue;",
                        "            if(StarCustomFaction(StarForWarr) != '') continue;",
                        "",
                        "            InjectAnswer('MoreWar', CT('Invests.WarrBuy'), 5);",
                        "            Inv_str = Inv_str + Format(CT('Invests.Warr'), 'money', GalaxyMoney(3, 4) * 10, 'star', Name(StarForWarr)) + CT('FormInfo.br');",
                        "            break;",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "// 4. ИНВЕСТИЦИИ В ФЛАГМАНЫ",
                        "if(FlagshipCD < 1) {",
                        "    if(total_warriors > 0) {",
                        "        if(round(tdwd / total_warriors) < 2) {",
                        "            for(j = 0; GalaxyStars() > j; j = j + 1) {",
                        "                StarForFlagship = StarNearbyStars(ShipStar(Player()), j);",
                        "",
                        "                if(StarOwner(StarForFlagship)) continue;",
                        "                if(StarCustomFaction(StarForFlagship) != '') continue;",
                        "",
                        "                InjectAnswer('Flagship', CT('Invests.FlagshipBuy'), 6);",
                        "                Inv_str = Inv_str + Format(CT('Invests.Flagship'), 'money', GalaxyMoney(4, 4) * 3, 'star', Name(StarForFlagship)) + CT('FormInfo.br');",
                        "                break;",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "// 5. ЭКОНОМИКА",
                        "if(EconomicsCD < 1) {",
                        "    InjectAnswer('Economics', CT('Invests.EconomicsBuy'), 7);",
                        "    Inv_str = Inv_str + CT('Invests.Economics') + CT('FormInfo.br');",
                        "}",
                        "",
                        "// 6. ИНВЕСТИЦИИ В ПИРАТОВ",
                        "if(PirateCD < 1) {",
                        "    if(total_pirates > 0) {",
                        "        if(round(total_transports / total_pirates) < 10) {",
                        "            int l = Rnd(10, 20);",
                        "            for(i = 0; GalaxyStars() > i; i = i + 1) {",
                        "                StarForPirate = StarNearbyStars(ShipStar(Player()), i);",
                        "",
                        "                if(StarOwner(StarForPirate) != 2) continue; // Только пиратские системы",
                        "                if(StarCustomFaction(StarForPirate) != '') continue;",
                        "                if(StarToCon(StarForPirate) == StarToCon(PlanetToStar(PlanetPirateClan()))) continue; // Исключаем Нигал",
                        "",
                        "                InjectAnswer('Pirate', CT('Invests.PirateBuy'), 8);",
                        "                Inv_str = Inv_str + Format(CT('Invests.Pirate'), 'money', GalaxyMoney(3, 4) * l, 'star', Name(StarForPirate)) + CT('FormInfo.br');",
                        "                break;",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "// 7. ИНВЕСТИЦИИ В ПОДДЕРЖКУ НА ПЕРЕДОВОЙ (МЕНЕДЖМЕНТ ВОЙНЫ)",
                        "if(MilitiaCD < 1) {",
                        "    StarForMilitia = 0;",
                        "",
                        "    // Ищем БЛИЖАЙШУЮ коалиционную систему, где идёт бой",
                        "    for(i = 0; GalaxyStars() > i; i = i + 1) {",
                        "        tdwd3 = GalaxyStar(i);",
                        "        if(!tdwd3) continue;",
                        "",
                        "        if(StarOwner(tdwd3)) continue;",
                        "        if(!StarBattle(tdwd3)) continue;",
                        "",
                        "        if(!StarForMilitia) {",
                        "            StarForMilitia = tdwd3;",
                        "        }",
                        "        else {",
                        "            if(round(sqrt(Dist2Star(ShipStar(Player()), StarForMilitia))) > round(sqrt(Dist2Star(ShipStar(Player()), tdwd3)))) {",
                        "                StarForMilitia = tdwd3;",
                        "            }",
                        "        }",
                        "    }",
                        "",
                        "    if(StarForMilitia) {",
                        "        int k = Rnd(4, 7);",
                        "        InjectAnswer('Militia', CT('Invests.MilitiaBuy'), 9);",
                        "        Inv_str = Inv_str + Format(CT('Invests.Militia'), 'money', GalaxyMoney(2, 4) * k, 'star', Name(StarForMilitia)) + CT('FormInfo.br');",
                        "    }",
                        "}",
                        "",
                        "// 8. БЛАГОТВОРИТЕЛЬНОСТЬ",
                        "if(PoorCD < 1) {",
                        "    InjectAnswer('Poor', CT('Invests.PoorBuy'), 10);",
                        "    Inv_str = Inv_str + Format(CT('Invests.Poor'), 'money', 2 * GalaxyMoney(3, 4)) + CT('FormInfo.br');",
                        "}",
                        "",
                        "// 9. ПОМОЩЬ СЕМЬЯМ ПОГИБШИХ",
                        "if(FamiliesCD < 1) {",
                        "    InjectAnswer('HelpFamilies', CT('Invests.FamiliesBuy'), 10);",
                        "    Inv_str = Inv_str + Format(CT('Invests.Families'), 'money', 3 * GalaxyMoney(3, 4)) + CT('FormInfo.br');",
                        "}",
                        "DChange(40);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 220,
                    "Pos.y": 970,
                    "Parent": -1,
                    "#": 550,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "MilitiaCD = Rnd(60,80);",
                        "for(i=0;i<k;i=i+1) {",
                        "    ShipRefit(BuyWarrior(FindPlanet(StarForMilitia,'NotNone')));",
                        "}",
