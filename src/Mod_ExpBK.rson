                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 970,
                    "Parent": -1,
                    "#": 548,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "ChangeGlobalRelationsPlanets(Player(),0,2,10,31);",
                        "ShipMoney(Player(),ShipMoney(Player()) - (GalaxyMoney(3,4)*5));",
                        "Sound('Sound.Buy');",
                        "for(i=0;StarPlanets(StarForLiners)>i;i=i+1) {",
                        "    ShipRefit(BuyTransport(FindPlanet(StarForLiners,'NotNone'),0));",
                        "}",
                        "AddPlanetNews(\"Неслыханная щедрость! Рейнджер <ShortName(Player())> проинвестировал строительство торгового флота в системе <Name(StarForLiners)>. Аналитики уверены, что это улучшит экономическую ситуацию в секторе.\",94);",
                        "LinerCD = Rnd(35,50);",
