                    [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 1140,
                    "Parent": -1,
                    "#": 96,
                    "Code.Type": "Init",
                    "Code": 
                    [
                        "if(CurrentMods('Expansion\\ExpPilotBridge')) IsExpPilotBridgeOn = 1;",
                        "",
                        "for(i = 1; i < 9; i = i + 1) type_name[i] = CT('Items.Goods.Name.' + i);",
                        "news_ok = 0;",
                        "",
                        "//Стартовый перебор числа БЦ в Галактике",
                        "for(i = 0; i < GalaxyStars(); i = i + 1)",
                        "{",
                        "    temp_dword = GalaxyStar(i);",
                        "    if(!StarRuins(temp_dword, 'BK')) continue;",
                        "    TotalBKCount = TotalBKCount + 1;",
                        "}",
                        "if(TotalBKCount) BKexist = 1;",
                        "",
                        "//Функция расчёта накопленных процентов для текущего состояния депозитного счёта",
                        "function DepositPercentCalc()",
                        "{",
                        "    float tflt = 0.0;",
                        "    tflt = 1.0 + 0.0001 * PlayerDepositPercent() / 12; //Считаем X",
                        "    tflt = exp((1.0 * PlayerDepositDay() / 365 * 12) * ln(tflt)); //Считаем Y и возводим X в степень Y",
                        "    int deposit_summ = round(min(tflt * PlayerDeposit(), 100000000)); //Применяем получившийся процент к сумме на счету и округляем результат",
                        "",
                        "    result = deposit_summ;",
                        "}",
                        "",
                        "//Отображаемый процент депозита: 9 -> 0.9, 95 -> 9.5, 120 -> 12.0",
                        "function DepositPercentText()",
                        "{",
                        "    str p = PlayerDepositPercent();",
                        "    if(PlayerDepositPercent() < 10) result = '0.' + p;",
                        "    else if(PlayerDepositPercent() < 100) result = substr(p, 0, 1) + '.' + substr(p, 1, 1);",
                        "    else result = substr(p, 0, 2) + '.' + substr(p, 2);",
                        "}",
                        "",
                        "function g_DepositPercentCalc()",
                        "{",
                        "    float tflt = 0.0;",
                        "    tflt = 1.0 + 0.0001 * PlayerDepositPercent() / 12; //Считаем X",
                        "    tflt = exp((1.0 * PlayerDepositDay() / 365 * 12) * ln(tflt)); //Считаем Y и возводим X в степень Y",
                        "    int deposit_summ = round(min(tflt * PlayerDeposit(), 100000000)); //Применяем получившийся процент к сумме на счету и округляем результат",
                        "",
                        "    result = deposit_summ;",
                        "}",
                        "",
                        "//Нужна для устранения проблемы при загрузке квиксейвов в магазине оборудования",
                        "function g_SetInMenuFlag(int set)",
                        "{",
                        "    in_menu = set;",
                        "}",
                        "",
                        "t_Answer_YES = CT('Script.Mod_ExpBK.Answer.YES');",
                        "t_Answer_IDecline = CT('Script.Mod_ExpBK.Answer.IDecline');",
                        "t_Answer_YouVeTalkedMeIntoIt = CT('Script.Mod_ExpBK.Answer.YouVeTalkedMeIntoIt');",
