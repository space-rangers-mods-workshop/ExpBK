                    "Code": 
                    [
                        "if(MessageBoxYesNo(\"Вы уверены в своём выборе? Вы потеряете всё, что имеете, и вернуть это не сможете никогда.\") == 0) AddDialogInject('CreditsInfo','',\"Вернуться к выбору\",0);",
                        "else {",
                        "    AddDialogInject('Bancrupcy',\"Производится оформление бумаг...\",\"Расписаться\",1);",
