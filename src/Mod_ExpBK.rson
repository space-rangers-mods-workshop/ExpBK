                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -20,
                    "Pos.y": 580,
                    "Parent": -1,
                    "#": 418,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "tstr2 = '</color>' + CT('FormRuins.BK.Policy.PlayerNo');",
                        "// Инициализируем tstr1 один раз в начале",
                        "tstr1 = '</color>' + CT('Invests.Stations.Base');",
                        "",
                        "temp_int = 0;",
                        "int total_offers = 0; // Глобальный счетчик предложений для корректного вывода NoBase",
                        "",
                        "// Осматриваем галактику на предмет недостачи станций",
                        "for(i = 0; GalaxySectors() > i; i = i + 1) {",
                        "    int temp_int_5 = 0;",
                        "    dword cur_con = GalaxySectors(i);",
                        "    if(!SectorVisible(cur_con)) continue;",
                        "    if(total_offers > 30) break;",
                        "",
                        "    int BK = 0;",
                        "    int SB = 0;",
                        "    int MC = 0;",
                        "    int RC = 0;",
                        "    int WB = 0;",
                        "    int PB = 0;",
                        "",
                        "    // Обязательно обнуляем tint2 перед расчетами для текущего сектора",
                        "    tint2 = 0;",
                        "",
                        "    for(j = 0; ConStars(cur_con) > j; j = j + 1) {",
                        "        cur_ruin = ConStar(cur_con, j);",
                        "        if(StarRuins(cur_ruin, 'BK') != 0) BK = BK + 1;",
                        "        if(StarRuins(cur_ruin, 'SB') != 0) SB = SB + 1;",
                        "        if(StarRuins(cur_ruin, 'MC') != 0) MC = MC + 1;",
                        "        if(StarRuins(cur_ruin, 'RC') != 0) RC = RC + 1;",
                        "        if(StarRuins(cur_ruin, 'WB') != 0) WB = WB + 1;",
                        "        if(StarRuins(cur_ruin, 'PB') != 0) PB = PB + 1;",
                        "    }",
                        "",
                        "    // Господь покарает вас за 99+ систем",
                        "    if((PB + WB + RC + MC + SB + BK) >= ConStars(cur_con)) continue;",
                        "    else {",
                        "        if(!BK) tint2 = tint2 + 10000;",
                        "        if(!PB) tint2 = tint2 + 20000;",
                        "        if(!WB) tint2 = tint2 + 40000;",
                        "        if(!RC) tint2 = tint2 + 80000;",
                        "        if(!MC) tint2 = tint2 + 160000;",
                        "        if(!SB) tint2 = tint2 + 320000;",
                        "    }",
                        "",
                        "    SFT('ExpBK: ' + PB + ' + ' + WB + ' + ' + RC + ' + ' + MC + ' + ' + SB + ' + ' + BK);",
                        "    SFT('ExpBK: ConStars is ' + ConStars(cur_con));",
                        "",
                        "    int h = 0;",
                        "    while(tint2 > 0) {",
                        "        dword save_star = 0;",
                        "        tint1 = 255;",
                        "        for(k = 0; ConStars(cur_con) > k; k = k + 1) {",
                        "            cur_ruin = ConStar(cur_con, k);",
                        "            if(StarOwner(cur_ruin)) continue;",
                        "            if(StarCustomFaction(cur_ruin) != '') continue;",
                        "            if(tint1 > StarRuins(cur_ruin)) {",
                        "                tint1 = StarRuins(cur_ruin);",
                        "                save_star = cur_ruin;",
                        "            }",
                        "        }",
                        "",
                        "        h = h + 1;",
                        "        SFT('ExpBK: ' + h + ', ' + tint2);",
                        "",
                        "        // Если нет доступных систем, сбрасываем tint2 во избежание бесконечного цикла",
                        "        if(save_star < 1) {",
                        "            tint2 = 0;",
                        "            break;",
                        "        }",
                        "        else {",
                        "            if(tint2 >= 320000) {",
                        "                tstr3 = '</color>' + Format(CT('Invests.Stations.SBBuy'), 'star', Name(save_star));",
                        "                InjectAnswer('EndStation', tstr3, tint2 + Id(save_star));",
                        "                tstr1 = tstr1 + Format('<br>') + '</color>' + CT('Invests.Stations.Divide') + Format('<br>') + Format(CT('Invests.Stations.SB'), 'star', Name(save_star), 'con', Name(cur_con), 'money', GalaxyMoney(4, 4) * 3);",
                        "                tint2 = tint2 - 320000;",
                        "                if(ShipMoney(Player()) < GalaxyMoney(4, 4) * 3) AddDialogBlock(tstr3, 1);",
                        "                temp_int_5 = temp_int_5 + 1;",
                        "            }",
                        "            else if(tint2 >= 160000) {",
                        "                tstr3 = '</color>' + Format(CT('Invests.Stations.MCBuy'), 'star', Name(save_star));",
                        "                InjectAnswer('EndStation', tstr3, tint2 + Id(save_star));",
                        "                tstr1 = tstr1 + Format('<br>') + '</color>' + CT('Invests.Stations.Divide') + Format('<br>') + Format(CT('Invests.Stations.MC'), 'star', Name(save_star), 'con', Name(cur_con), 'money', GalaxyMoney(4, 4) * 3 / 2);",
                        "                tint2 = tint2 - 160000;",
                        "                if(ShipMoney(Player()) < GalaxyMoney(4, 4) * 3 / 2) AddDialogBlock(tstr3, 1);",
                        "                temp_int_5 = temp_int_5 + 1;",
                        "            }",
                        "            else if(tint2 >= 80000) {",
                        "                tstr3 = '</color>' + Format(CT('Invests.Stations.RCBuy'), 'star', Name(save_star));",
                        "                InjectAnswer('EndStation', tstr3, tint2 + Id(save_star));",
                        "                tstr1 = tstr1 + Format('<br>') + '</color>' + CT('Invests.Stations.Divide') + Format('<br>') + Format(CT('Invests.Stations.RC'), 'star', Name(save_star), 'con', Name(cur_con), 'money', GalaxyMoney(4, 4) * 3 / 2);",
                        "                tint2 = tint2 - 80000;",
                        "                if(ShipMoney(Player()) < GalaxyMoney(4, 4) * 3 / 2) AddDialogBlock(tstr3, 1);",
                        "                temp_int_5 = temp_int_5 + 1;",
                        "            }",
                        "            else if(tint2 >= 40000) {",
                        "                tstr3 = '</color>' + Format(CT('Invests.Stations.WBBuy'), 'star', Name(save_star));",
                        "                InjectAnswer('EndStation', tstr3, tint2 + Id(save_star));",
                        "                tstr1 = tstr1 + Format('<br>') + '</color>' + CT('Invests.Stations.Divide') + Format('<br>') + Format(CT('Invests.Stations.WB'), 'star', Name(save_star), 'con', Name(cur_con), 'money', GalaxyMoney(4, 4) * 7 / 2);",
                        "                tint2 = tint2 - 40000;",
                        "                if(ShipMoney(Player()) < GalaxyMoney(4, 4) * 7 / 2) AddDialogBlock(tstr3, 1);",
                        "                temp_int_5 = temp_int_5 + 1;",
                        "            }",
                        "            else if(tint2 >= 20000) {",
                        "                tstr3 = '</color>' + Format(CT('Invests.Stations.PBBuy'), 'star', Name(save_star));",
                        "                InjectAnswer('EndStation', tstr3, tint2 + Id(save_star));",
                        "                tstr1 = tstr1 + Format('<br>') + '</color>' + CT('Invests.Stations.Divide') + Format('<br>') + Format(CT('Invests.Stations.PB'), 'star', Name(save_star), 'con', Name(cur_con), 'money', GalaxyMoney(4, 4) * 4);",
                        "                tint2 = tint2 - 20000;",
                        "                if(ShipMoney(Player()) < GalaxyMoney(4, 4) * 4) AddDialogBlock(tstr3, 1);",
                        "                temp_int_5 = temp_int_5 + 1;",
                        "            }",
                        "            else if(tint2 >= 10000) {",
                        "                tstr3 = '</color>' + Format(CT('Invests.Stations.BKBuy'), 'star', Name(save_star));",
                        "                InjectAnswer('EndStation', tstr3, tint2 + Id(save_star));",
                        "                tstr1 = tstr1 + Format('<br>') + '</color>' + CT('Invests.Stations.Divide') + Format('<br>') + Format(CT('Invests.Stations.BK'), 'star', Name(save_star), 'con', Name(cur_con), 'money', GalaxyMoney(4, 4) * 2);",
                        "                tint2 = tint2 - 10000;",
                        "                if(ShipMoney(Player()) < GalaxyMoney(4, 4) * 2) AddDialogBlock(tstr3, 1);",
                        "                temp_int_5 = temp_int_5 + 1;",
                        "            }",
                        "        }",
                        "        total_offers = total_offers + temp_int_5; // Суммируем все созданные предложения",
                        "    }",
                        "}",
                        "",
                        "// Проверка вынесена за цикл и использует суммарный счетчик предложений",
                        "if(!total_offers) {",
                        "    tstr1 = tstr1 + Format('<br>') + '</color>' + CT('Invests.Stations.Divide') + Format('<br>') + '</color>' + CT('Invests.Stations.NoBase');",
                        "}",
                        "DChange(95);",
                        "exit;"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 160,
                    "Pos.y": 580,
                    "Parent": -1,
                    "#": 419,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "function IdToStar(int star_id)",
                        "{",
                        "    result = 0;",
                        "    if(!star_id) exit;",
                        "    for(int cursor = 0; cursor < GalaxyStars(); cursor = cursor + 1)",
                        "    {",
                        "        dword star = GalaxyStar(cursor);",
                        "        if(!star) continue;",
                        "        if(Id(star) == star_id)",
                        "        {",
                        "            result = star;",
                        "            exit;",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "tint2 = GAnswerData;",
                        "",
                        "if(tint2 >= 320000) {",
                        "    tint2 = tint2 - 320000;",
                        "    ShipMoney(Player(), ShipMoney(Player()) - GalaxyMoney(4, 4) * 3);",
                        "    temp_dword = IdToStar(tint2);",
                        "    cur_ruin = BuildRuins(temp_dword, t_SB);",
                        "",
                        "    tstr4 = '</color>' + Format(CT('GalaxyNews.CreateNewObject.SB' + Rnd(0, int(CT('GalaxyNews.CreateNewObject.SBCount')))), Format('<0>',\"<0>\",Name), Name(cur_ruin), Format('<0>',\"<0>\",'<Star>'), Name(temp_dword), Format('<0>',\"<0>\",'<Sector>'), Name(StarToCon(temp_dword)));",
                        "    NewsAdd(tstr4);",
                        "    AddPlanetNews(tstr4, 41);",
                        "}",
                        "else if(tint2 >= 160000) {",
                        "    tint2 = tint2 - 160000;",
                        "    ShipMoney(Player(), ShipMoney(Player()) - GalaxyMoney(4, 4) * 3 / 2);",
                        "    temp_dword = IdToStar(tint2);",
                        "    cur_ruin = BuildRuins(temp_dword, t_MC);",
                        "",
                        "    tstr4 = '</color>' + Format(CT('GalaxyNews.CreateNewObject.MC' + Rnd(0, int(CT('GalaxyNews.CreateNewObject.MCCount')))), Format('<0>',\"<0>\",Name), Name(cur_ruin), Format('<0>',\"<0>\",'<Star>'), Name(temp_dword), Format('<0>',\"<0>\",'<Sector>'), Name(StarToCon(temp_dword))); // ИСПРАВЛЕНО: MCCount",
                        "    NewsAdd(tstr4);",
                        "    AddPlanetNews(tstr4, 41);",
                        "}",
                        "else if(tint2 >= 80000) {",
                        "    tint2 = tint2 - 80000;",
                        "    ShipMoney(Player(), ShipMoney(Player()) - GalaxyMoney(4, 4) * 3 / 2);",
                        "    temp_dword = IdToStar(tint2);",
                        "    cur_ruin = BuildRuins(temp_dword, t_RC);",
                        "",
                        "    tstr4 = '</color>' + Format(CT('GalaxyNews.CreateNewObject.RC' + Rnd(0, int(CT('GalaxyNews.CreateNewObject.RCCount')))), Format('<0>',\"<0>\",Name), Name(cur_ruin), Format('<0>',\"<0>\",'<Star>'), Name(temp_dword), Format('<0>',\"<0>\",'<Sector>'), Name(StarToCon(temp_dword))); // ИСПРАВЛЕНО: RCCount",
                        "    NewsAdd(tstr4);",
                        "    AddPlanetNews(tstr4, 41);",
                        "    ChangeGlobalRelationsPlanets(Player(), 0, 2, 10, 31);",
                        "}",
                        "else if(tint2 >= 40000) {",
                        "    tint2 = tint2 - 40000;",
                        "    ShipMoney(Player(), ShipMoney(Player()) - GalaxyMoney(4, 4) * 7 / 2);",
                        "    temp_dword = IdToStar(tint2);",
                        "    cur_ruin = BuildRuins(temp_dword, t_WB);",
                        "",
                        "    tstr4 = '</color>' + Format(CT('GalaxyNews.CreateNewObject.WB' + Rnd(0, int(CT('GalaxyNews.CreateNewObject.WBCount')))), Format('<0>',\"<0>\",Name), Name(cur_ruin), Format('<0>',\"<0>\",'<Star>'), Name(temp_dword), Format('<0>',\"<0>\",'<Sector>'), Name(StarToCon(temp_dword))); // ИСПРАВЛЕНО: WBCount",
                        "    NewsAdd(tstr4);",
                        "    AddPlanetNews(tstr4, 41);",
                        "    ChangeGlobalRelationsPlanets(Player(), 0, 2, 30, 31);",
                        "    RelationToRanger(PlanetPirateClan(), Player(), RelationToRanger(PlanetPirateClan(), Player()) - Rnd(2, 5));",
                        "}",
                        "else if(tint2 >= 20000) {",
                        "    tint2 = tint2 - 20000;",
                        "    ShipMoney(Player(), ShipMoney(Player()) - GalaxyMoney(4, 4) * 4);",
                        "    temp_dword = IdToStar(tint2);",
                        "    cur_ruin = BuildRuins(temp_dword, t_PB);",
                        "",
                        "    tstr4 = '</color>' + Format(CT('GalaxyNews.CreateNewObject.PB' + Rnd(0, int(CT('GalaxyNews.CreateNewObject.PBCount')))), Format('<0>',\"<0>\",Name), Name(cur_ruin), Format('<0>',\"<0>\",'<Star>'), Name(temp_dword), Format('<0>',\"<0>\",'<Sector>'), Name(StarToCon(temp_dword))); // ИСПРАВЛЕНО: PBCount",
                        "    NewsAdd(tstr4);",
                        "    AddPlanetNews(tstr4, 41);",
                        "    ChangeGlobalRelationsPlanets(Player(), 0, 2, 20, 2);",
                        "    ChangeGlobalRelationsPlanets(Player(), 0, 4, 10, 1 + 4);",
                        "    ChangeGlobalRelationsPlanets(Player(), 0, 4, 30, 8 + 16);",
                        "}",
                        "else if(tint2 >= 10000) {",
                        "    tint2 = tint2 - 10000;",
                        "    ShipMoney(Player(), ShipMoney(Player()) - GalaxyMoney(4, 4) * 2);",
                        "    temp_dword = IdToStar(tint2);",
                        "    cur_ruin = BuildRuins(temp_dword, t_BK);",
                        "",
                        "    tstr4 = '</color>' + Format(CT('GalaxyNews.CreateNewObject.BK' + Rnd(0, int(CT('GalaxyNews.CreateNewObject.BKCount')))), Format('<0>',\"<0>\",Name), Name(cur_ruin), Format('<0>',\"<0>\",'<Star>'), Name(temp_dword), Format('<0>',\"<0>\",'<Sector>'), Name(StarToCon(temp_dword))); // ИСПРАВЛЕНО: BKCount",
                        "    NewsAdd(tstr4);",
                        "    AddPlanetNews(tstr4, 41);",
                        "}",
                        "",
                        "Sound('Sound.Buy');",
                        "DChange(71);",
                        "exit;"
                    ]
                },
