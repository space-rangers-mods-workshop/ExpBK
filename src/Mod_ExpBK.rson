            ],
            "DialogMessages": 
            [
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 144,
                    "Msg": "Торговая лицензия упрощает передачу данных по совершённым вами сделкам в центры рейнджеров. При этом, повышение в рейтинге происходит более точно, в зависимости от вашего торгового опыта.\r\nВсего за <temp_int_2> cr, сроком на пять лет.",
                    "DMsg.Num": "0"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 150,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 145,
                    "Msg": "Отлично! Вы настоящий бизнесмен! Заполните вот эти бланки в трёх экземплярах.\r\nИ не забудьте продлить лицензию, за месяц до окончания срока.",
                    "DMsg.Num": "1"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 300,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 146,
                    "Msg": "Цена продления составляет <temp_int_2> cr. Продлеваем ещё на 5 лет?",
                    "DMsg.Num": "2"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 480,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 147,
                    "Msg": "<t_Msg_ExcellentAndDonTForgetToRenewYourLicense>",
                    "DMsg.Num": "3"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 630,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 148,
                    "Msg": "Состояние счёта: <temp_int_5> cr.\r\nГодовой процент: <temp_str_4>\r\n\r\nВы можете пополнять или снимать средства с вашего счёта со стандартной комиссией в <clr>5%<clrEnd>.\r\n\r\nБаланс счёта не может составлять менее <clr>1000<clrEnd> cr. Минимальная сумма пополнения или снятия средств со счёта составляет <clr>100<clrEnd> cr.\r\n<temp_str_3><temp_str_5>",
                    "DMsg.Num": "4"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 780,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 149,
                    "Msg": "<tstr1>",
                    "DMsg.Num": "5"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 150,
                    "Msg": "<tstr2>",
                    "DMsg.Num": "6"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1110,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 151,
                    "Msg": "<tstr1>",
                    "DMsg.Num": "7"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1260,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 152,
                    "Msg": "<tstr1>",
                    "DMsg.Num": "8"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1440,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 153,
                    "Msg": "<tstr2>",
                    "DMsg.Num": "9"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1590,
                    "Pos.y": 625,
                    "Parent": -1,
                    "#": 154,
                    "Msg": "<tstr1>",
                    "DMsg.Num": "10"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 155,
                    "Msg": "<t_Msg_IfYouWishToTradeMoreEffectivelyWeSuggest>",
                    "DMsg.Num": "11"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 150,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 156,
                    "Msg": "<tstr1>",
                    "DMsg.Num": "12"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 300,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 157,
                    "Msg": "Ваша задолженность: <PlayerDebt()> cr.\r\nДата погашения: <GameDateTxtByTurn(PlayerDebtDate())> <clr>г.<clrEnd>\r\nОсталось дней: <PlayerDebtDate()-CurTurn()>\r\nКоличество просрочек: <PlayerDebtCnt()>\r\n\r\nЗдесь вы можете погасить кредитную задолженность на любую оставшуюся сумму с комиссией всего в <clr>5%<clrEnd>.\r\n\r\nМинимальная сумма погашения составляет <clr>100<clrEnd> cr.",
                    "DMsg.Num": "13"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 480,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 158,
                    "Msg": "Решили вновь приобрести у нас торговую лицензию? На этот раз её цена составит полновесные <temp_int_2> cr.",
                    "DMsg.Num": "14"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 630,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 159,
                    "Msg": "<t_Msg_ExcellentIKnewYouWouldComeBackToUsForThe>",
                    "DMsg.Num": "15"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 780,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 160,
                    "Msg": "<t_Msg_SuitYourself>",
                    "DMsg.Num": "16"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 161,
                    "Msg": "<t_Msg_OhComeOnNowBeAHumanBeing>",
                    "DMsg.Num": "17"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1110,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 162,
                    "Msg": "<t_Msg_HowCanYouEvenDoThatForShame>",
                    "DMsg.Num": "18"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1260,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 163,
                    "Msg": "<t_Msg_HowCanYouEvenDoThatShameOnYouTwiceOver>",
                    "DMsg.Num": "19"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1440,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 164,
                    "Msg": "А я-то думал, что как бывший лицензированный торговец вы должны прекрасно понимать все преимущества этого документа. Видимо, я в вас ошибся...\r\nЧто ж, желаю и дальше оставаться бывшим, рейнджер <Player>.",
                    "DMsg.Num": "20"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1590,
                    "Pos.y": 650,
                    "Parent": -1,
                    "#": 165,
                    "Msg": "Крайне неразумно с вашей стороны. Срок действия лицензии закончится, и вы всё равно вернётесь к нам за переоформлением, только в тот раз это будет стоить дороже.\r\nПриятной вам потери денег, рейнджер <Player>.",
                    "DMsg.Num": "21"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 166,
                    "Msg": "<t_Msg_OurNetworkTriesToKeepItsClientsInformedO>",
                    "DMsg.Num": "22"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 150,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 167,
                    "Msg": "",
                    "DMsg.Num": "23"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 300,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 168,
                    "Msg": "<tstr1>",
                    "DMsg.Num": "24"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 480,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 169,
                    "Msg": "Итак, рейнджер, теперь вы - как будто бы совсем новый пилот в космосе!\r\n\r\nЛетайте и нарабатывайте",
                    "DMsg.Num": "25"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 630,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 170,
                    "Msg": "Итак, вы как член корпуса Рейнджеров имеете право на получение кредита по льготным условиям.\r\nКроме того, мы можем провести обслуживание ваших задолженностей (например, произвести часитичную или полную их оплату) или перекредитовать вас по льготным условиям.\r\nБолее того, из нашего центра вы можете произвести оплату задолженностей перед правительствами различных планет Коалиции.\r\nНу а если вы часто сталкиваетесь с тем, что починка после напряжённого и очень долгого космического боя заставляет вас расстреливать астероиды и подбирать с них минералы, то мы можем предложить вам оформить страховку Экстренной Починки.\r\n\r\nИ всё это - по лучшим условиям в Галактике и с минимальной комиссией за операции!",
                    "DMsg.Num": "26"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 780,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 171,
                    "Msg": "Итак, рейнджер...\r\n\r\nНа данный момент ваш долг составляет <temp_int_1> cr.\r\n\r\nЕго вам необходимо вернуть до <temp_str>.\r\n\r\nЖелаете погасить кредит полностью, или частично?",
                    "DMsg.Num": "27"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 172,
                    "Msg": "Отлично. Ваш кредит полностью погашен.\r\n\r\nЖелаете что-нибудь ещё?",
                    "DMsg.Num": "28"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1110,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 173,
                    "Msg": "<t_Msg_AmongOtherThingsWeCanMakeARemotePaymentO>",
                    "DMsg.Num": "29"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1260,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 174,
                    "Msg": "Выбранная планета: <temp_str>\r\nНаселяющая раса: <temp_str_3>\r\nТекущее отношение: <temp_str_2>\r\n\r\nЖелаете внести какую-нибудь сумму в казну планеты?",
                    "DMsg.Num": "30"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1440,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 175,
                    "Msg": "Отлично, деньги уже перечислены в счёт правительства <temp_str>.\r\n\r\nРекомендуем вам изучить другие наши услуги. Сеть бизнес-центров может многое, очень многое.",
                    "DMsg.Num": "31"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1590,
                    "Pos.y": 675,
                    "Parent": -1,
                    "#": 176,
                    "Msg": "<t_Msg_AlasAtTheMomentThereIsNothingWeCanDoForY>",
                    "DMsg.Num": "32"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 177,
                    "Msg": "Итак...\r\n\r\nДа, рейнджер, в данный момент мы можем провести для вас процедуру оформления банкротства.\r\n\r\nВ неё включаются:\r\n- Изъятие всех средств, включая вклады\r\n- Изъятие всего накопленного имущества\r\n- Закрытие всех задолженностей перед сетью бизнес-центров\r\n- Налаживание отношений с правительствами-участниками Коалиции Разумных Рас\r\n\r\nЖелаете продолжить?",
                    "DMsg.Num": "33"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 150,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 178,
                    "Msg": "Итак, прямо сейчас мы можем оформить для вас кредитную карту <clr>\"Шиза Голд\"<clrEnd> по выгодным условиям:\r\n\r\nЛимит снятия с карты: <temp_int_5> cr.\r\nПроцент на долг: <clr>10<clrEnd>% ежемесячно\r\nЛимит операций в день: <clr>5<clrEnd>\r\nМинимальная сумма для проведения операции: <clr>100<clrEnd> cr.\r\nКомиссия за снятие свыше 200 cr. включительно - <clr>2<clrEnd>%\r\n\r\nВас устраивают такие условия?",
                    "DMsg.Num": "34"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 300,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 179,
                    "Msg": "Итак, текущее состояние карты:\r\n\r\nБаланс: <temp_int_4>/<temp_int_5> cr.\r\n\r\nЧто желаете сделать?",
                    "DMsg.Num": "35"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 480,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 180,
                    "Msg": "Замечательно.\r\n\r\nКредитная карта уже оформлена на ваше имя и отправлена на ваше именное хранилище.\r\nПользуйтесь на здоровье, рейнджер!",
                    "DMsg.Num": "36"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 630,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 181,
                    "Msg": "Отлично. Все необходимые операции уже завершены.\r\n\r\nБлагодарим за использование наших услуг.",
                    "DMsg.Num": "37"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 780,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 182,
                    "Msg": "Вы уверены, что хотите отказаться от нашей карты и льготных условий кредитования?\r\n\r\nКонечно, вы всегда можете оформить её заново, но до тех пор вы потеряете доступ к огромному количеству бонусов, которые даёт наша карта!",
                    "DMsg.Num": "38"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 183,
                    "Msg": "Отлично. Кредитная карта уже изъята у вас и уничтожена.\r\n\r\nРады, что вы воспользовались нашими услугами. Если вас интересует что-то ещё - обращайтесь, мы всегда рады вам помочь.",
                    "DMsg.Num": "39"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1110,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 184,
                    "Msg": "Мы координируем целый комплекс различных экономических программ. Это может быть все, что угодно. От помощи изголодавшимся детям, до постройки нового межзвездного флота. Как меценат, вы можете облегчить жизнь другим людям, помочь нашим вооруженным силам, стать всеобщим любимцем. Кроме того, иногда нам поступают заявки на совершенно уникальные мероприятия, поучаствовать в которых сочтёт за честь любой гражданин Коалиции.\r\n\r\nВот какие программы доступны прямо сейчас:\r\n<Inv_str>\r\n---\r\nВыбирайте себе любую программу, не стесняйтесь.",
                    "DMsg.Num": "40"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1260,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 185,
                    "Msg": "Как это хватит инвестиций? Стыдно, <Player>! На инвестициях стоит наш мир. Чтобы вы делали без нас, без наших дотаций?\r\nПодумайте, может, у вас есть лишние деньги? Возьмите кредит, в конце концов, и накормите голодных!..\r\nВпрочем, я погорячился и приношу извинения. Это ваше личное дело. Мы сами-то благотворительностью не занимаемся, просто ведем бизнес. Вы для нас пример, рейнджер <Player>.",
                    "DMsg.Num": "41"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1440,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 186,
                    "Msg": "---------\r\nКак известно, на данный момент одной из самых уязвимых структур Коалиции - впрочем, как и во все времена - являются гражданские суда. А точнее - торговые.\r\n\r\nЗа счёт инвестированных средств мы могли бы оснастить <clr>5<clrEnd> новеньких транспортов в системе <Name(StarForLiners)>.\r\n\r\nСтоимость оснащения каждого корабля - <GalaxyMoney(3,4)> cr., соответственно, в сумме оплата инициативы выдет в <5*GalaxyMoney(3,4)> cr.\r\n---------",
                    "DMsg.Num": "42"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1590,
                    "Pos.y": 700,
                    "Parent": -1,
                    "#": 187,
                    "Msg": "<t_Msg_ExcellentRangerTheFundsHaveAlreadyBeenTr>",
                    "DMsg.Num": "43"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 188,
                    "Msg": "---------\r\nПрямо сейчас враги атаковали систему <Name(StarForMilitia)>. Правительства системы подняли все имеющиеся силы, но не на всё хватает ресурсов.\r\n\r\nЗа счёт ваших средств мы бы помогли местным правительствам оснастить добровольцем всем необходимым для ведения боевых действий на орбите.\r\n\r\nСтоимость оснащения каждого корабля из планируемых <k> единиц - <GalaxyMoney(2,4)> cr., соответственно, в сумме оплата инициативы выдет в <k*GalaxyMoney(2,4)> cr.\r\n---------",
                    "DMsg.Num": "44"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 150,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 189,
                    "Msg": "<t_Msg_ExcellentRangerWeHaveAlreadyOrganizedThe>",
                    "DMsg.Num": "45"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 300,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 190,
                    "Msg": "<t_Msg_InConnectionWithARecentOrderOfTheGalacti>",
                    "DMsg.Num": "46"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 480,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 191,
                    "Msg": "<t_Msg_UnfortunatelyWeHaveNotFoundSufficientGro>",
                    "DMsg.Num": "47"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 630,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 192,
                    "Msg": "<t_Msg_SoPerhapsYouMeetAllTheCriteriaInViewOfTh>",
                    "DMsg.Num": "48"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 780,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 193,
                    "Msg": "---------\r\nКонечно, дозакупка военного флота - хорошая инициатива, но когда её бывает мало? Вот и правительства системы <Name(StarForWarr)> запросили у нас возможность разместить их просьбу профинансировать строительство крупного военног флота.\r\n\r\nВсего, согласно контракту, будет собрано <clr>10<clrEnd> пилотов, которые тут же примутся за патрулирование системы.\r\n\r\nСтоимость оснащения каждого корабля - <GalaxyMoney(3,4)> cr., соответственно, в сумме оплата инициативы выдет в <10*GalaxyMoney(3,4)> cr.\r\n---------",
                    "DMsg.Num": "49"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 194,
                    "Msg": "---------\r\nНемаловажную часть оборонительного ресурса флота Коалиции составляют крупные корабли - <clr>линкоры<clrEnd>, которые обычно выполняют роль <clr>флагманов<clrEnd>. Каждый такой корабль оснащён по последнему слову техники, имеет особые возможности и колоссальную огневую мощь. Один такой КВСМК планирует построить в системе <Name(StarForFlagship)>. Согласно плану, строительство корабля должно начаться через пару лет, но правительства системы обратились к нам с просьбой открыть сбор средств на постройку, чтобы ускорить процесс и поскорее защитить их систему столь могучим кораблём.\r\n\r\nСтоимость постройки и оснащения линкора - <GalaxyMoney(4,4)*3> cr.\r\n---------",
                    "DMsg.Num": "50"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1110,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 195,
                    "Msg": "---------\r\nНекоторые так называемые \"вольные пилоты\", оказавшиеся волею судеб в портах системы <Name(StarForPirate)>, оказались без средств для покупки нового корабля и оснащения на него. Некоторые круги, заинтересованные в создании конкуренции в сфере транспортных перевозок, готовы закрыть глаза на такие финансовые махинации, и допустить этих пилотов в космопорты.\r\n\r\nВопрос остаётся только за самой покупкой кораблей! Всего за раз удаётся собрать <l> пилотов.\r\n\r\nСтоимость оснащения каждого корабля - <GalaxyMoney(3,4)> cr., соответственно, в сумме оплата инициативы выдет в <l*GalaxyMoney(3,4)> cr.\r\n---------",
                    "DMsg.Num": "51"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1260,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 196,
                    "Msg": "Несмотря на давнюю историю покорения просторов Рукава, даже на данный момент далеко не все планеты заселены. Увы, это происходит из-за того, что многим из них требуется ресурсоёмкий и очень затратный <clr>терраформинг<clrEnd>. Поэтому для таких проектов привлекаются инвесторы. Приводим список планет, на заселение которых подготавливается группа специалистов:\r\n--------------------\r\n<tstr1>\r\n--------------------\r\n\r\nИтак, каков ваш выбор?",
                    "DMsg.Num": "52"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1440,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 197,
                    "Msg": "<t_Msg_ManyOfTheCoalitionSEconomiesAreGoingThro>",
                    "DMsg.Num": "53"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1590,
                    "Pos.y": 725,
                    "Parent": -1,
                    "#": 198,
                    "Msg": "<t_Msg_ExcellentRangerTheFundsHaveAlreadyBeenTr_2>",
                    "DMsg.Num": "54"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 199,
                    "Msg": "<t_Msg_ThankYouForSuchASubstantialContributionR>",
                    "DMsg.Num": "55"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 150,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 200,
                    "Msg": "<t_Msg_TheFreelancePilotsThankYouRangerForSuchA>",
                    "DMsg.Num": "56"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 300,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 201,
                    "Msg": "Итак, вы выбрали:\r\n\r\n-------------------\r\nПланета: <Name(tdwd3)>\r\nСистема: <Name(PlanetToStar(tdwd3))>\r\nРаса заселения - <tstr5>\r\n\r\nСрок терраформирования и заселения - <clr>130<clrEnd> + <clr>20<clrEnd> дн.\r\nСтоимость операции - <tint3> cr.\r\n-------------------",
                    "DMsg.Num": "57"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 480,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 202,
                    "Msg": "Отлично! Мы уже выслали колонизационный караван, и скоро начнётся терраформинг и возведение фундаментов для главных административных и производственных зданий.\r\n\r\nВы увидите уведомления в новостях всех Галактики!",
                    "DMsg.Num": "58"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 630,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 203,
                    "Msg": "Многие экономики Коалиции переживают не лучшие времена. Поэтому всегда есть возможность вложить средства в строительство нового завода, или, например, и вовсе помочь правительству планеты провести <clr>индустриализацию<clrEnd> своей экономики.\r\n\r\nИтак, приводим вам список планет, в экономику которых вы могли бы внести вклад.\r\n\r\nСумма взноса - <(GalaxyMoney(4,4)*30)> cr.",
                    "DMsg.Num": "59"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 780,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 204,
                    "Msg": "<t_Msg_BravoRangerFutureGenerationsWillThankYou>",
                    "DMsg.Num": "60"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 205,
                    "Msg": "О, конечно, конечно!\r\n\r\nСитуация, когда рейнджер остаётся без каких-либо средств, чтобы починить своё оружие и вновь вступить в бой с захватчиками, не могла и не может огорчать Галактический Совет. После обращения нескольких сенаторов к нашему совету директоров была разработана так называемая \"Страховка Экстренной Починки\".\r\n\r\nОна позволит вам, рейнджер, в любое время получить полный ремонт <color=225,20,20>неисправного</color> оборудования на любой <clr>индустриальной<clrEnd> планете, где обычно размещаются партнёрские мастерские и службы ремонта.\r\n\r\nЕсли вас заинтересовало наше предложение, то у нас есть три тарифа на выбор на <clr>два<clrEnd>:\r\n-----------------------\r\n\"Базовый тариф\"\r\nСтоимость: <clr><(GalaxyMoney(4,4) * 2)><clrEnd>\r\n\r\nДанный тариф позволит вам в срочном порядке восстановить боеспособность корабля\r\n\r\nВосстанавливаем:\r\n<color=225,20,20>Двигатель</color>\r\n<color=225,20,20>Дроида</color>\r\n<color=225,20,20>Все орудия</color>\r\n-----------------------\r\n\"Расширенный тариф\"\r\nСтоимость: <clr><(GalaxyMoney(4,4) * 3)><clrEnd>\r\n\r\nДанный тариф позволит вам в срочном порядке восстановить все защитные и атакующие системы корабля\r\n\r\nВосстанавливаем:\r\n<color=225,20,20>Двигатель</color>\r\n<color=225,20,20>Дроида</color>\r\n<color=225,20,20>Все орудия</color>\r\n<color=225,20,20>Генератор защитного поля</color>\r\n<color=225,20,20>Топливный бак</color>\r\n-----------------------\r\n\"Полный тариф\"\r\nСтоимость: <clr><(GalaxyMoney(4,4) * 5)><clrEnd>\r\n\r\nДанный тариф позволит вам в срочном порядке полностью восстановить ваш корабль\r\n\r\nВосстанавливаем:\r\n<color=225,20,20>Двигатель</color>\r\n<color=225,20,20>Дроида</color>\r\n<color=225,20,20>Все орудия</color>\r\n<color=225,20,20>Генератор защитного поля</color>\r\n<color=225,20,20>Топливный бак</color>\r\n<color=225,20,20>Захват</color>\r\n<color=225,20,20>Сканер</color>\r\n<color=225,20,20>Радар</color>\r\n<color=225,20,20>Все артефакты</color>\r\n<color=225,20,20>Обшивку вашего корпуса</color>, с устранением всех <color=225,20,20>помех</color>.\r\n-----------------------",
                    "DMsg.Num": "61"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1110,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 206,
                    "Msg": "Отличный выбор, рейнджер!\r\n\r\nМы уже оформили на ваше имя страховку \"Экстренная починка\" с выбранным вами пакетом на <clr>два<clrEnd> года.\r\n\r\nБлагодарим за пользование услугами нашей сети!",
                    "DMsg.Num": "62"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1260,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 207,
                    "Msg": "<t_Msg_AreYouSureRangerIfItTurnsOutYouHaveTooLi>",
                    "DMsg.Num": "63"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1440,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 208,
                    "Msg": "Стоимость продления страхового полиса на <clr>1<clrEnd> стандартные сутки - <tint1> cr.\r\n\r\nМаксимальный срок продления за одну процедуру - <clr>300<clrEnd> стандартных дней.",
                    "DMsg.Num": "64"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 1590,
                    "Pos.y": 750,
                    "Parent": -1,
                    "#": 209,
                    "Msg": "<t_Msg_ExcellentWeHaveAlreadyUpdatedTheTermOfYo>",
                    "DMsg.Num": "65"
                },
                {
                    "Type": "TDialogMsg",
                    "Name": "",
                    "Pos.x": 0,
                    "Pos.y": 775,
