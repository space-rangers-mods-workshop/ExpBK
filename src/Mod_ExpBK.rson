            ],
            "Stars": 
            [
                {
                    "Type": "TStar",
                    "Name": "InitStar",
                    "Pos.x": 0,
                    "Pos.y": 265,
                    "Parent": -1,
                    "#": 91,
                    "Constellation": 0,
                    "Priority": 0,
                    "NoKling": false,
